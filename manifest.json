{
  "manifest_version": 3,
  "name": "RBX Analytics Grabber (Internal \u00b7 Phase 1)",
  "version": "0.6.0",
  "description": "Portfolio dashboard + grabber for owned Roblox experiences. Browse your groups and games, toggle scheduled grabs, and pull all analytics for a universeId by replaying the dashboard's own requests in your session. Own-data only. No credentials are ever read or stored.",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://users.roblox.com/*",
    "https://groups.roblox.com/*",
    "https://games.roblox.com/*",
    "https://thumbnails.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://create.roblox.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://create.roblox.com/*"
      ],
      "js": [
        "collector.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Indigo LiveOps"
  }
}
