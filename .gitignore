# Secrets — never commit. web/.env.local holds the Supabase secret key and DB
# password. Use web/.env.local.example as the template.
.env
.env.local
.env*.local

# Client analytics — real revenue, DAU and retention for Indigo's games.
# Internal private repo, so the irreplaceable parts are committed and only the
# regenerable ones are ignored:
#
#   data/raw/     COMMITTED. The untouched capture bundles. These cannot be
#                 re-created: Roblox drops performance/error data after a few
#                 months (Climb Up Mountain's is already unrecoverable), and a
#                 delisted game takes everything with it. 8MB, worth it.
#   data/verify/  COMMITTED. Ground-truth dashboard exports + the coverage and
#                 inventory measurements. The harness is useless without them.
#   data/games/   IGNORED. Fully regenerable — see HANDOFF.md, one command per
#                 bundle in data/raw/. 21MB of derived output, no need to ship.
/data/*
!/data/verify/
!/data/raw/
# grab-report.json records what each grab ASKED for and what came back. It is
# not derivable from the raw bundles (a request that failed left no capture),
# and `npm run audit-plan` reads it to tell a proven query shape from a guess.
# Without it a fresh clone reports false "stale claim" failures.
!/data/games/
/data/games/*/*
!/data/games/*/grab-report.json
# code-reads.md is NOT regenerable from data/raw/ — it is read out of the live
# place through Studio at one PlaceVersion, and that version moves. It travels.
!/data/games/*/code-reads.md

# Raw capture dumps at the repo root (same reason)
rbx-grab-*.json

# Node / Next
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Scratch
*.log


# Cross-game analysis (2026-09-02). Scripts, charts and the report are committed;
# the DuckDB file is not — it rebuilds from data/games/*/metrics/*.csv in seconds
# via `python analysis/load.py`, and it is 7MB of pure derived output.
/analysis/analytics.duckdb
/analysis/__pycache__/

# Playwright's dedicated grab profile. Normally lives outside the repo
# (~/.rbx-grab-profile) but RBX_GRAB_PROFILE can point anywhere — a browser
# profile holds a live Roblox session cookie and must never be committable.
.rbx-grab-profile/
**/.rbx-grab-profile/
